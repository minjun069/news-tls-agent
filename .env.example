# 이 파일을 .env로 복사해 채운다. .env는 절대 커밋하지 않는다 (NFR-10).
# 실행 모드별 접속 정보는 docs/TECH_DESIGN.md §4.1 참조.

# ─────────────────────────────────────────────
# LLM · 임베딩
# ─────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─────────────────────────────────────────────
# MS-SQL
# ─────────────────────────────────────────────
# 모드 A (WSL 개발) : WSL2는 별도 네트워크라 localhost가 아니다.
#                     Windows 호스트 IP → ip route show | awk '/^default/ {print $3}'
# 모드 B (compose) : mssql
# 모드 C (CI)      : localhost
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=newsagent
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_CERT=yes

# 네이티브 설치와 컨테이너의 기본 collation이 다르다.
# 한글 정렬뿐 아니라 NVARCHAR 비교와 LIKE 동작이 달라진다 (TECH_DESIGN §4.2).
MSSQL_COLLATION=Korean_Wansung_CI_AS

# ─────────────────────────────────────────────
# Qdrant
# ─────────────────────────────────────────────
# 모드 A : http://localhost:6333
# 모드 B : http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# ─────────────────────────────────────────────
# Notion (S8에서 사용)
# ─────────────────────────────────────────────
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
