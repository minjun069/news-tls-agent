# 이 파일을 .env로 복사해 채운다. .env는 절대 커밋하지 않는다 (NFR-10).
# 실행 모드별 접속 정보는 docs/architecture/overview.md §4.1 참조.

# ─────────────────────────────────────────────
# LLM · 임베딩
# ─────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072

# S5 수집 루프 상한. docs/requirements/timeline.md의 종료 정책과 함께 바꾼다.
TIMELINE_MAX_ROUNDS=4
TIMELINE_MAX_CHAIN_DEPTH=2
TIMELINE_MAX_CLARIFICATIONS=2
TIMELINE_SEARCH_TOP_K=20

# ─────────────────────────────────────────────
# API · 브라우저
# ─────────────────────────────────────────────
# 쉼표로 여러 출처를 구분한다.
CORS_ORIGINS=http://localhost:5173
# 비우면 프로젝트의 logs/api.log를 사용한다.
API_LOG=

# ─────────────────────────────────────────────
# MS-SQL
# ─────────────────────────────────────────────
# 모드 A (WSL 개발) : WSL2는 별도 네트워크라 localhost가 아니다.
#                     Windows 호스트 IP → ip route show | awk '/^default/ {print $3}'
# 모드 B (compose) : mssql
# 모드 C (CI)      : localhost
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=newsagent
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_CERT=yes

# 네이티브 설치와 컨테이너의 기본 collation이 다르다.
# 한글 정렬뿐 아니라 NVARCHAR 비교와 LIKE 동작이 달라진다 (docs/architecture/overview.md §4.2).
MSSQL_COLLATION=Korean_Wansung_CI_AS

# ─────────────────────────────────────────────
# Qdrant
# ─────────────────────────────────────────────
# 모드 A : http://localhost:6333
# 모드 B : http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# ─────────────────────────────────────────────
# MCP
# ─────────────────────────────────────────────
# 비우면 프로젝트의 logs/mcp-audit.log를 사용한다.
MCP_AUDIT_LOG=

# ─────────────────────────────────────────────
# 브리핑 내보내기
# ─────────────────────────────────────────────
# 상대 경로는 프로젝트 루트 기준이다. API와 MCP가 같은 디렉터리를 사용해야 한다.
EXPORT_DOWNLOAD_DIR=downloads
# 비우면 Linux NanumGothic 또는 Windows 맑은 고딕의 알려진 경로를 순서대로 찾는다.
# 다른 환경에서는 한글을 포함하는 TTF 파일의 절대 경로를 지정한다.
PDF_FONT_PATH=
# Notion은 토큰과 요청의 parent_page_id 또는 아래 기본 상위 페이지가 모두 필요하다.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
